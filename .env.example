# Kopirajte u .env.local (lokalno) i postavite iste varijable na Vercelu.
# Lokalne vrijednosti dobijete naredbom: npm run db:start, pa npx supabase status -o env

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Samo za testove i server; NIKAD NEXT_PUBLIC_ i nikad u klijentu.
SUPABASE_SECRET_KEY=
